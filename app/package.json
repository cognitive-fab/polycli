{
  "name": "polycli",
  "version": "0.3.0",
  "private": true,
  "description": "A Windows terminal for Claude Code workstreams",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/main/__tests__/*.test.js",
    "test:unit": "node --test src/main/__tests__/tests.test.js",
    "smoke": "node scripts/smoke.js",
    "persist": "node scripts/persist.js",
    "bridge:pack": "npx -y @anthropic-ai/mcpb pack ../bridge ../out/polycli-bridge.mcpb"
  },
  "devDependencies": {
    "electron": "^45.2.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "1.2.0-beta.18"
  }
}
